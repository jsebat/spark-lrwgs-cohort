#!/usr/bin/env bash
#SBATCH --job-name=pdnm_conc
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
#SBATCH --time=01:00:00
# M3/P18: concordance of all final tables with the original pipeline's de novo sets, per class group.
# Baselines in $BASELINES (default $EVIDENCE_DIR/../baselines). Outputs $FINAL_DIR/concordance.<class>.{tsv,per_proband.tsv,summary.json}.
set -euo pipefail
HERE="${PHASE_DNM_HOME:-}"
[ -n "$HERE" ] || { [ -n "${SLURM_SUBMIT_DIR:-}" ] && [ -d "${SLURM_SUBMIT_DIR}/src/phase_dnm" ] && HERE="$SLURM_SUBMIT_DIR"; }
[ -n "$HERE" ] || HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$HERE/config/phase_dnm.env"
: "${EVIDENCE_DIR:?}" "${PHASE_DNM_PYTHON:?}"
export PYTHONPATH="$HERE/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
FINAL_DIR="${FINAL_DIR:-$EVIDENCE_DIR/../final}"; BASELINES="${BASELINES:-$EVIDENCE_DIR/../baselines}"
for cls in snv_indel sv tr; do
  "$PHASE_DNM_PYTHON" -m phase_dnm.cli concordance --final-dir "$FINAL_DIR" --baselines "$BASELINES" --class-group "$cls" \
      --out "$FINAL_DIR/concordance.$cls.tsv" --drop-neither
done

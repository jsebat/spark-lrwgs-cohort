#!/bin/bash
#SBATCH --account=ddp195 --partition=ind-shared --qos=ind-shared-normal --nodes=1 --ntasks=1 --cpus-per-task=2 --mem=32G --time=04:00:00
#SBATCH --job-name=meth_stage2a --output=meth_stage2a.%j.out
module load cpu singularitypro || module load singularitypro
export SIF="${SIF:?container with bcftools/tabix}"

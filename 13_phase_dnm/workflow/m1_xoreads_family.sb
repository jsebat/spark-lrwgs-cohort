#!/usr/bin/env bash
#SBATCH --job-name=pdnm_xoreads
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=01:00:00
# M1b2 for one family: classify every child's transmission change points as CROSSOVER / SWITCH_ERROR / AMBIGUOUS
# from the parents' haplotagged reads (DESIGN P3). Needs <child>.changepoints.tsv from `phase-dnm transmission`.
# Usage: sbatch workflow/m1_xoreads_family.sb <FAMILY_ID>      (or via the array wrapper with LIST)
set -euo pipefail
FAMILY="${1:-}"
if [ -z "$FAMILY" ] && [ -n "${LIST:-}" ] && [ -n "${SLURM_ARRAY_TASK_ID:-}" ]; then FAMILY=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST"); fi
[ -n "$FAMILY" ] || { echo "usage: $0 <FAMILY_ID>  (or LIST + array)" >&2; exit 2; }
HERE="${PHASE_DNM_HOME:-}"
[ -n "$HERE" ] || { [ -n "${SLURM_SUBMIT_DIR:-}" ] && [ -d "${SLURM_SUBMIT_DIR}/src/phase_dnm" ] && HERE="$SLURM_SUBMIT_DIR"; }
[ -n "$HERE" ] || HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -d "$HERE/src/phase_dnm" ] || { echo "ERROR: cannot locate the 13_phase_dnm directory; got '$HERE'" >&2; exit 2; }
source "$HERE/config/phase_dnm.env"
: "${MANIFEST:?}" "${CALLSET_ROOT:?}" "${PHASE_DIR:?}" "${PHASE_DNM_PYTHON:?}"
export PYTHONPATH="$HERE/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
OUT="$PHASE_DIR/$FAMILY"

bam_of() { ls "$CALLSET_ROOT/$FAMILY"/out/merged_haplotagged_bam/*/"$1".*.haplotagged.bam 2>/dev/null | head -1; }
bai_of() { local b; b=$(bam_of "$1"); echo "${b/merged_haplotagged_bam\//merged_haplotagged_bam_index/}.bai"; }
vcf_of() { ls "$CALLSET_ROOT/$FAMILY"/out/phased_small_variant_vcf/*/"$1".*small_variants.phased.vcf.gz 2>/dev/null | head -1; }
tbi_of() { local v; v=$(vcf_of "$1"); echo "${v/phased_small_variant_vcf\//phased_small_variant_vcf_index/}.tbi"; }

n_done=0
while IFS=$'\t' read -r child father mother; do
  [ -n "$father" ] && [ "$father" != "0" ] && [ -n "$mother" ] && [ "$mother" != "0" ] || { echo "skip duo (P19)"; continue; }
  CP="$OUT/$child.changepoints.tsv"
  [ -s "$CP" ] || { echo "ERROR: $CP missing - run the orient+transmission job first" >&2; exit 3; }
  for f in "$(bam_of "$father")" "$(bai_of "$father")" "$(vcf_of "$father")" "$(tbi_of "$father")" \
           "$(bam_of "$mother")" "$(bai_of "$mother")" "$(vcf_of "$mother")" "$(tbi_of "$mother")"; do
    [ -s "$f" ] || { echo "ERROR: a parent BAM/VCF or its index was not found for $FAMILY" >&2; exit 3; }
  done
  t0=$(date +%s)
  "$PHASE_DNM_PYTHON" -m phase_dnm.cli xo-reads --changepoints "$CP" --out "$OUT/$child.changepoints.resolved.tsv" \
      --father "$father" --father-bam "$(bam_of "$father")" --father-bai "$(bai_of "$father")" \
      --father-vcf "$(vcf_of "$father")" --father-vcf-index "$(tbi_of "$father")" \
      --mother "$mother" --mother-bam "$(bam_of "$mother")" --mother-bai "$(bai_of "$mother")" \
      --mother-vcf "$(vcf_of "$mother")" --mother-vcf-index "$(tbi_of "$mother")" \
      --child-orientation "$OUT/$child.orientation.tsv" \
      --thresholds "$HERE/config/thresholds.yaml"
  echo "xo-reads done for one child of $FAMILY in $(( $(date +%s) - t0 )) s"
  n_done=$((n_done+1))
done < <(awk -F'\t' -v f="$FAMILY" 'NR>1 && $2==f && $7=="offspring" {print $1"\t"$3"\t"$4}' "$MANIFEST")
[ "$n_done" -gt 0 ] || { echo "ERROR: no child processed for $FAMILY" >&2; exit 3; }
printf 'OK\t%s\t%d children\n' "$(date -Is)" "$n_done" > "$OUT/.m1_xoreads.status.tmp" && mv "$OUT/.m1_xoreads.status.tmp" "$OUT/m1_xoreads.status"

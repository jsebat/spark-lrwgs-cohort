#!/usr/bin/env bash
#SBATCH --job-name=pdnm_svrev
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=04:00:00
# SV-only re-review with the interval evidence of P17 (depth inside vs flanks per haplotype for all six haplotypes,
# junction reads by haplotype, het-SNV persistence) and the P8 deletion rule. Rewrites <child>.sv.evidence.tsv in place
# and re-extracts the SV features so the classifier sees the new block.
set -euo pipefail
FAMILY="${1:-}"
[ -n "$FAMILY" ] || { LIST="${LIST:?}"; FAMILY=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST"); }
HERE="${PHASE_DNM_HOME:-}"
[ -n "$HERE" ] || HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$HERE/config/phase_dnm.env"
: "${MANIFEST:?}" "${CALLSET_ROOT:?}" "${PHASE_DIR:?}" "${EVIDENCE_DIR:?}" "${PHASE_DNM_PYTHON:?}"
export PYTHONPATH="$HERE/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
O="$CALLSET_ROOT/$FAMILY/out"; PD="$PHASE_DIR/$FAMILY"; ED="$EVIDENCE_DIR/$FAMILY"
bam_of() { ls "$O"/merged_haplotagged_bam/*/"$1".*.haplotagged.bam 2>/dev/null | head -1; }
bai_of() { local b; b=$(bam_of "$1"); echo "${b/merged_haplotagged_bam\//merged_haplotagged_bam_index/}.bai"; }
SVJ=$(ls "$O"/sv_supporting_reads/*.json.gz 2>/dev/null | head -1)
SMALLV=$(ls "$O"/joint_small_variants_vcf/*.vcf.gz 2>/dev/null | head -1)
MASKARGS=""; for m in ${MASK_BEDS:-}; do [ -s "$m" ] && MASKARGS="$MASKARGS --mask $m"; done
REFARG=""; [ -n "${REF_FA:-}" ] && [ -s "${REF_FA}" ] && REFARG="--ref $REF_FA"
n=0
while IFS=$'\t' read -r child father mother; do
  [ -n "$father" ] && [ "$father" != "0" ] || continue
  CAND="$ED/candidates/$child.sv.candidates.tsv"; [ -s "$CAND" ] || { echo "no SV candidates for one child"; continue; }
  t0=$(date +%s)
  "$PHASE_DNM_PYTHON" -m phase_dnm.cli review --candidates "$CAND" --out "$ED/evidence/$child.sv.evidence.tsv.tmp" \
      --orientation "$PD/$child.orientation.tsv" --transmission "$PD/$child.transmission.tsv" --changepoints "$PD/$child.changepoints.resolved.tsv" \
      --child-bam "$(bam_of "$child")" --child-bai "$(bai_of "$child")" --father-bam "$(bam_of "$father")" --father-bai "$(bai_of "$father")" \
      --mother-bam "$(bam_of "$mother")" --mother-bai "$(bai_of "$mother")" \
      ${SVJ:+--sv-supporting-reads "$SVJ"} ${SMALLV:+--smallvar-vcf "$SMALLV" --child-sample "$child"} \
      --only-class SV --salt "$FAMILY" --thresholds "$HERE/config/thresholds.yaml"
  mv "$ED/evidence/$child.sv.evidence.tsv.tmp" "$ED/evidence/$child.sv.evidence.tsv"
  "$PHASE_DNM_PYTHON" -m phase_dnm.cli likelihood --evidence "$ED/evidence/$child.sv.evidence.tsv" \
      --out "$ED/evidence/$child.sv.evidence.lik.tsv" --thresholds "$HERE/config/thresholds.yaml" 2>/dev/null || \
      cp "$ED/evidence/$child.sv.evidence.tsv" "$ED/evidence/$child.sv.evidence.lik.tsv"
  ANNOT=""; A="${ANNOT_DIR:-$EVIDENCE_DIR/../annot}/real/$child.sv.annot.tsv"; [ -s "$A" ] && ANNOT="--annot $A"
  "$PHASE_DNM_PYTHON" -m phase_dnm.cli features --evidence "$ED/evidence/$child.sv.evidence.lik.tsv" \
      --candidates "$CAND" --manifest "$MANIFEST" --child "$child" --registry "$HERE/config/features.yaml" \
      --out "$ED/features/$child.sv.features.tsv" --rf-out "$ED/features/$child.sv.features.rf.tsv" \
      $ANNOT $MASKARGS $REFARG --no-require-all-features
  echo "SV re-review + features for one child of $FAMILY in $(( $(date +%s) - t0 )) s"
  n=$((n+1))
done < <(awk -F'\t' -v f="$FAMILY" 'NR>1 && $2==f && $7=="offspring" {print $1"\t"$3"\t"$4}' "$MANIFEST")
[ "$n" -gt 0 ] || { echo "ERROR: no child processed for $FAMILY" >&2; exit 3; }
printf 'OK\t%s\t%d children\n' "$(date -Is)" "$n" > "$ED/m2_review_sv.status"

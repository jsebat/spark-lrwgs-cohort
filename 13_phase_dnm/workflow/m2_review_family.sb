#!/usr/bin/env bash
#SBATCH --job-name=pdnm_review
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=04:00:00
# M2 review for one family: six-haplotype evidence for every candidate of every complete-trio child, three classes.
# Usage: sbatch workflow/m2_review_family.sb <FAMILY_ID>            (all candidates)
#        MAX_PER_CLASS=1500 sbatch workflow/m2_review_family.sb <FAMILY_ID>   (smoke test)
set -euo pipefail
FAMILY="${1:-}"
if [ -z "$FAMILY" ] && [ -n "${LIST:-}" ] && [ -n "${SLURM_ARRAY_TASK_ID:-}" ]; then FAMILY=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST"); fi
[ -n "$FAMILY" ] || { echo "usage: $0 <FAMILY_ID>  (or LIST + array)" >&2; exit 2; }
HERE="${PHASE_DNM_HOME:-}"
[ -n "$HERE" ] || { [ -n "${SLURM_SUBMIT_DIR:-}" ] && [ -d "${SLURM_SUBMIT_DIR}/src/phase_dnm" ] && HERE="$SLURM_SUBMIT_DIR"; }
[ -n "$HERE" ] || HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -d "$HERE/src/phase_dnm" ] || { echo "ERROR: cannot locate the 13_phase_dnm directory; got '$HERE'" >&2; exit 2; }
source "$HERE/config/phase_dnm.env"
: "${MANIFEST:?}" "${CALLSET_ROOT:?}" "${PHASE_DIR:?}" "${EVIDENCE_DIR:?}" "${PHASE_DNM_PYTHON:?}"
export PYTHONPATH="$HERE/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
O="$CALLSET_ROOT/$FAMILY/out"; PD="$PHASE_DIR/$FAMILY"; ED="$EVIDENCE_DIR/$FAMILY"; mkdir -p "$ED/evidence"
bam_of() { ls "$O"/merged_haplotagged_bam/*/"$1".*.haplotagged.bam 2>/dev/null | head -1; }
bai_of() { local b; b=$(bam_of "$1"); echo "${b/merged_haplotagged_bam\//merged_haplotagged_bam_index/}.bai"; }
trb_of() { ls "$O"/trgt_spanning_reads/*/"$1".*.trgt.spanning.sorted.bam 2>/dev/null | head -1; }
tri_of() { local b; b=$(trb_of "$1"); echo "${b/trgt_spanning_reads\//trgt_spanning_reads_index/}.bai"; }
SVJ=$(ls "$O"/sv_supporting_reads/*.json.gz 2>/dev/null | head -1)
SMALLV=$(ls "$O"/joint_small_variants_vcf/*.vcf.gz 2>/dev/null | head -1)   # phased family VCF: SV het-SNV persistence inside the interval (P17)
MAXARG=""; [ -n "${MAX_PER_CLASS:-}" ] && MAXARG="--max-per-class $MAX_PER_CLASS"

n_done=0
while IFS=$'\t' read -r child father mother; do
  [ -n "$father" ] && [ "$father" != "0" ] && [ -n "$mother" ] && [ "$mother" != "0" ] || { echo "skip duo (P19)"; continue; }
  for s in "$child" "$father" "$mother"; do
    for f in "$(bam_of "$s")" "$(bai_of "$s")" "$(trb_of "$s")" "$(tri_of "$s")"; do [ -s "$f" ] || { echo "ERROR: BAM/index missing for a member of $FAMILY" >&2; exit 3; }; done
  done
  for f in "$PD/$child.orientation.tsv" "$PD/$child.transmission.tsv" "$PD/$child.changepoints.resolved.tsv"; do [ -s "$f" ] || { echo "ERROR: M1 table missing: $(basename "$f")" >&2; exit 3; }; done
  for cls in snv_indel sv tr; do
    CAND="$ED/candidates/$child.$cls.candidates.tsv"; [ -s "$CAND" ] || { echo "ERROR: $CAND missing - run m2_candidates first" >&2; exit 3; }
    t0=$(date +%s)
    "$PHASE_DNM_PYTHON" -m phase_dnm.cli review --candidates "$CAND" --out "$ED/evidence/$child.$cls.evidence.tsv" \
        --reads-out "$ED/evidence/$child.$cls.reads.jsonl.gz" \
        --orientation "$PD/$child.orientation.tsv" --transmission "$PD/$child.transmission.tsv" --changepoints "$PD/$child.changepoints.resolved.tsv" \
        --child-bam "$(bam_of "$child")" --child-bai "$(bai_of "$child")" --father-bam "$(bam_of "$father")" --father-bai "$(bai_of "$father")" \
        --mother-bam "$(bam_of "$mother")" --mother-bai "$(bai_of "$mother")" \
        --child-tr-bam "$(trb_of "$child")" --child-tr-bai "$(tri_of "$child")" --father-tr-bam "$(trb_of "$father")" --father-tr-bai "$(tri_of "$father")" \
        --mother-tr-bam "$(trb_of "$mother")" --mother-tr-bai "$(tri_of "$mother")" \
        ${SVJ:+--sv-supporting-reads "$SVJ"} ${SMALLV:+--smallvar-vcf "$SMALLV" --child-sample "$child"} \n        $MAXARG --salt "$FAMILY" --thresholds "$HERE/config/thresholds.yaml"
    echo "review $cls done for one child of $FAMILY in $(( $(date +%s) - t0 )) s"
  done
  n_done=$((n_done+1))
done < <(awk -F'\t' -v f="$FAMILY" 'NR>1 && $2==f && $7=="offspring" {print $1"\t"$3"\t"$4}' "$MANIFEST")
[ "$n_done" -gt 0 ] || { echo "ERROR: no child processed for $FAMILY" >&2; exit 3; }
printf 'OK\t%s\t%d children\tmax_per_class=%s\n' "$(date -Is)" "$n_done" "${MAX_PER_CLASS:-all}" > "$ED/.review.status.tmp" && mv "$ED/.review.status.tmp" "$ED/m2_review.status"

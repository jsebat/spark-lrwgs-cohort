# 13_phase_dnm — Snakemake orchestration (DESIGN Q9: Snakemake, ASSUMED confirmed by JS 2026-09-12).
#
# Thin layer over the family scripts in this directory: every rule runs one proven `*_family.sb` (or cohort script) with the
# same environment file (config/phase_dnm.env) and the same resources the sbatch headers used, so the DAG reproduces the
# per-family chain that was run by hand on the cohort:
#
#   M1  orient+transmission -> xo-reads -> hapdepth (per sample) -> phase-qc (cohort)
#   M2  candidates -> review -> reclassify (+likelihood, annotate, features)
#   M3  integrate -> concordance (cohort)
#   M4  swap -> synthetic trios (per seed) -> annotate_synthetic -> train -> rescore -> external truth
#
# Usage on Expanse:   snakemake all --profile workflow/profiles/expanse -j 40
#                     snakemake m4 --profile workflow/profiles/expanse            (after `all`)
# Dry run:            snakemake all -n -s workflow/Snakefile --configfile workflow/config.yaml   (target BEFORE --configfile: it takes several files)
# Dry run 2026-09-13 against the cohort layout: all = 101 jobs, m4 = 81 (M1, hapdepth and candidates recognised as up to date).
# Families = the complete-trio families of the manifest (duos excluded, DESIGN P19). Identifiers stay in the manifest.
import csv, os

configfile: "workflow/config.yaml"

ENV = config["env"]                      # config/phase_dnm.env (gitignored; the example is config/phase_dnm.env.example)
HERE = os.path.abspath(os.path.dirname(workflow.snakefile) + "/..")


def env_value(key):
    """Read one KEY=... line from the env file (paths only; no shell expansion beyond $LRC/$HOME)."""
    vals = {}
    with open(ENV) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = v.split("#")[0].strip().strip('"')
            vals[k.strip()] = v
    v = vals.get(key, "")
    for k2 in ("LRC", "HOME"):
        v = v.replace("$" + k2, vals.get(k2, os.environ.get(k2, "")))
    return v


MANIFEST = env_value("MANIFEST")
PHASE_DIR = env_value("PHASE_DIR")
EVIDENCE_DIR = env_value("EVIDENCE_DIR")
TRAIN_DIR = env_value("TRAIN_DIR") or os.path.join(EVIDENCE_DIR, "..", "train")
FINAL_DIR = env_value("FINAL_DIR") or os.path.join(EVIDENCE_DIR, "..", "final")


def complete_trio_families():
    fams, kids = set(), []
    with open(MANIFEST, newline="") as fh:
        rows = list(csv.DictReader(fh, delimiter="\t"))
    ids = {r["sample_id"] for r in rows}
    for r in rows:
        if r["role"] == "offspring" and r["father_id"] in ids and r["mother_id"] in ids:
            fams.add(r["family_id"]); kids.append((r["family_id"], r["sample_id"]))
    return sorted(fams), kids


FAMILIES, CHILDREN = complete_trio_families()
SEEDS = [int(s) for s in str(config.get("seeds", "0,1,2,3,4")).split(",")]
CLASS_GROUPS = ["snv_indel", "sv", "tr"]
SB = lambda name: os.path.join(HERE, "workflow", name)
COMMON = "export PHASE_DNM_HOME=%s; " % HERE


rule all:
    input:
        os.path.join(PHASE_DIR, "cohort_phase_qc.tsv"),
        expand(os.path.join(EVIDENCE_DIR, "{family}", "m3_integrate.status"), family=FAMILIES),
        expand(os.path.join(FINAL_DIR, "concordance.{cls}.summary.json"), cls=CLASS_GROUPS),


# ------------------------------------------------------------------ M1
rule m1_orient:
    output: os.path.join(PHASE_DIR, "{family}", "m1.status")
    resources: mem_mb=4000, runtime=120, cpus_per_task=1
    shell: COMMON + "bash " + SB("m1_orient_family.sb") + " {wildcards.family} && printf 'OK\\n' > {output}"

rule m1_xoreads:
    input: rules.m1_orient.output
    output: os.path.join(PHASE_DIR, "{family}", "m1_xoreads.status")
    resources: mem_mb=4000, runtime=120, cpus_per_task=1
    shell: COMMON + "bash " + SB("m1_xoreads_family.sb") + " {wildcards.family} && printf 'OK\\n' > {output}"

SAMPLES = sorted({r["sample_id"] for r in csv.DictReader(open(MANIFEST, newline=""), delimiter="\t") if r["family_id"] in FAMILIES})

rule m1_hapdepth:
    # hapdepth_array.sb is written for a sample array (LIST + SLURM_ARRAY_TASK_ID); one sample per rule instance
    output: os.path.join(PHASE_DIR, "hapdepth", "{sample}.hapdepth.tsv.gz")
    resources: mem_mb=4000, runtime=240, cpus_per_task=1
    shell:
        COMMON + "mkdir -p %s/hapdepth/lists && echo {wildcards.sample} > %s/hapdepth/lists/{wildcards.sample}.txt && "
        "LIST=%s/hapdepth/lists/{wildcards.sample}.txt SLURM_ARRAY_TASK_ID=1 bash " % (PHASE_DIR, PHASE_DIR, PHASE_DIR) + SB("hapdepth_array.sb")

rule phase_qc:
    input: expand(os.path.join(PHASE_DIR, "{family}", "m1_xoreads.status"), family=FAMILIES), expand(os.path.join(PHASE_DIR, "hapdepth", "{sample}.hapdepth.tsv.gz"), sample=SAMPLES)
    output: os.path.join(PHASE_DIR, "cohort_phase_qc.tsv")
    resources: mem_mb=4000, runtime=30, cpus_per_task=1
    shell: COMMON + "source %s; $PHASE_DNM_PYTHON -m phase_dnm.cli phase-qc --manifest $MANIFEST --phase-dir $PHASE_DIR --hapdepth-dir $PHASE_DIR/hapdepth --thresholds %s/config/thresholds.yaml" % (ENV, HERE)


# ------------------------------------------------------------------ M2
rule m2_candidates:
    output: os.path.join(EVIDENCE_DIR, "{family}", "candidates", "m2_candidates.status")
    resources: mem_mb=4000, runtime=60, cpus_per_task=1
    shell: COMMON + "bash " + SB("m2_candidates_family.sb") + " {wildcards.family}"

rule m2_review:
    input: rules.m2_candidates.output, rules.m1_xoreads.output
    output: os.path.join(EVIDENCE_DIR, "{family}", "m2_review.status")
    resources: mem_mb=4000, runtime=240, cpus_per_task=1
    shell: COMMON + "bash " + SB("m2_review_family.sb") + " {wildcards.family}"

rule m2_reclassify:
    # reclassify -> likelihood -> features (with annotation and geometry when present); the review output stays immutable
    input: rules.m2_review.output
    output: os.path.join(EVIDENCE_DIR, "{family}", "m2_reclassify.status")
    resources: mem_mb=4000, runtime=120, cpus_per_task=1
    shell: COMMON + "REPLACE_REVIEW=1 bash " + SB("m2_reclassify_family.sb") + " {wildcards.family}"

rule annotate_real:
    # P26 cohort annotation for one class group (gnomAD via slivar, leave-one-family-out founder counts, sib-shared)
    input: expand(os.path.join(EVIDENCE_DIR, "{family}", "candidates", "m2_candidates.status"), family=FAMILIES)
    output: touch(os.path.join(EVIDENCE_DIR, "..", "annot", "real", ".done.{cls}"))
    resources: mem_mb=32000, runtime=360, cpus_per_task=2
    shell: COMMON + "bash " + SB("m4_annotate.sb") + " {wildcards.cls}"


# ------------------------------------------------------------------ M3
rule m3_integrate:
    input: rules.m2_reclassify.output
    output: os.path.join(EVIDENCE_DIR, "{family}", "m3_integrate.status")
    params: rf=lambda w: ("RF_PROBS_DIR=%s/harness/rf_probs TAU_DIR=%s/harness " % (TRAIN_DIR, TRAIN_DIR)) if os.path.isdir(os.path.join(TRAIN_DIR, "harness", "rf_probs")) else ""
    resources: mem_mb=4000, runtime=60, cpus_per_task=1
    shell: COMMON + "{params.rf}bash " + SB("m3_integrate_family.sb") + " {wildcards.family}"

rule m3_concordance:
    input: expand(os.path.join(EVIDENCE_DIR, "{family}", "m3_integrate.status"), family=FAMILIES)
    output: expand(os.path.join(FINAL_DIR, "concordance.{cls}.summary.json"), cls=CLASS_GROUPS)
    resources: mem_mb=32000, runtime=90, cpus_per_task=1
    shell: COMMON + "bash " + SB("m3_concordance.sb")


# ------------------------------------------------------------------ M4
rule m4_swap:
    output: expand(os.path.join(TRAIN_DIR, "folds", "synthetic_trios.seed{seed}.tsv"), seed=SEEDS)
    resources: mem_mb=2000, runtime=10, cpus_per_task=1
    shell: COMMON + "source %s; $PHASE_DNM_PYTHON -m phase_dnm.cli swap --manifest $MANIFEST --out-dir %s/folds --n-folds %d --seeds %s" % (ENV, TRAIN_DIR, int(config.get("n_folds", 5)), ",".join(str(s) for s in SEEDS))

checkpoint m4_synthetic_seed:
    # all synthetic trios of one seed (array in the hand-run version); one status per trio inside TRAIN_DIR/seed<k>/
    input: os.path.join(TRAIN_DIR, "folds", "synthetic_trios.seed{seed}.tsv"), expand(os.path.join(EVIDENCE_DIR, "{family}", "m2_reclassify.status"), family=FAMILIES)
    output: touch(os.path.join(TRAIN_DIR, "seed{seed}", ".synthetic.done"))
    resources: mem_mb=8000, runtime=1440, cpus_per_task=2
    shell:
        COMMON + "T={input[0]}; N=$(( $(wc -l < $T) - 1 )); for i in $(seq 1 $N); do bash " + SB("m4_synthetic_trio.sb") + " $T $i && bash " + SB("m4_annotate_synthetic.sb") + " $T $i; done"

rule m4_train:
    input: expand(os.path.join(TRAIN_DIR, "seed{seed}", ".synthetic.done"), seed=SEEDS), expand(os.path.join(EVIDENCE_DIR, "..", "annot", "real", ".done.{cls}"), cls=["snv_indel", "sv"])
    output: os.path.join(TRAIN_DIR, "harness", "cv_report.{cls}.json")
    resources: mem_mb=64000, runtime=480, cpus_per_task=8
    shell: COMMON + "OUT_DIR=%s/harness bash " % TRAIN_DIR + SB("m4_train.sb") + " {wildcards.cls} " + ",".join(str(s) for s in SEEDS)

rule m4_rescore:
    input: rules.m4_train.output
    output: touch(os.path.join(TRAIN_DIR, "harness", ".rescored.{cls}"))
    resources: mem_mb=48000, runtime=120, cpus_per_task=4
    shell: COMMON + "source %s; $PHASE_DNM_PYTHON -m phase_dnm.cli rescore --class-group {wildcards.cls} --manifest $MANIFEST --evidence-dir $EVIDENCE_DIR --harness-dir %s/harness --folds-dir %s/folds --seeds %s" % (ENV, TRAIN_DIR, TRAIN_DIR, ",".join(str(s) for s in SEEDS))

rule m4_external:
    input: expand(os.path.join(TRAIN_DIR, "harness", ".rescored.{cls}"), cls=CLASS_GROUPS)
    output: touch(os.path.join(TRAIN_DIR, "harness", ".external.done"))
    resources: mem_mb=32000, runtime=120, cpus_per_task=4
    shell: COMMON + "SEED=0 OUT_DIR=%s/harness bash " % TRAIN_DIR + SB("m4_external.sb") + " && SEED=0 OUT_DIR=%s/harness bash " % TRAIN_DIR + SB("m4_external_wes.sb")

rule m4:
    input: expand(os.path.join(TRAIN_DIR, "harness", ".rescored.{cls}"), cls=CLASS_GROUPS), os.path.join(TRAIN_DIR, "harness", ".external.done")

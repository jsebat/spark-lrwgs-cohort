#!/usr/bin/env bash
#SBATCH --job-name=pdnm_recls
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=02:00:00
# Re-run the rule layer from the immutable review output, then the likelihood post-step and feature extraction, for
# one family (no BAM access). Layout per child and class in $EVIDENCE_DIR/<FAMILY>/evidence/:
#   <child>.<cls>.evidence.review.tsv   the review output (written once by m2_review_family.sb; moved here on first run)
#   <child>.<cls>.evidence.tsv          the WORKING table = reclassified review output (what every downstream step reads)
#   <child>.<cls>.evidence.lik.tsv      + P9 columns
# Usage: sbatch workflow/m2_reclassify_family.sb <FAMILY_ID>   (or LIST + array); MASK_BEDS / REF_FA as for features.
set -euo pipefail
FAMILY="${1:-}"
if [ -z "$FAMILY" ] && [ -n "${LIST:-}" ] && [ -n "${SLURM_ARRAY_TASK_ID:-}" ]; then FAMILY=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST"); fi
[ -n "$FAMILY" ] || { echo "usage: $0 <FAMILY_ID>  (or LIST + array)" >&2; exit 2; }
HERE="${PHASE_DNM_HOME:-}"
[ -n "$HERE" ] || { [ -n "${SLURM_SUBMIT_DIR:-}" ] && [ -d "${SLURM_SUBMIT_DIR}/src/phase_dnm" ] && HERE="$SLURM_SUBMIT_DIR"; }
[ -n "$HERE" ] || HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -d "$HERE/src/phase_dnm" ] || { echo "ERROR: cannot locate the 13_phase_dnm directory; got '$HERE'" >&2; exit 2; }
source "$HERE/config/phase_dnm.env"
: "${MANIFEST:?}" "${EVIDENCE_DIR:?}" "${PHASE_DNM_PYTHON:?}"
export PYTHONPATH="$HERE/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
THR="$HERE/config/thresholds.yaml"
ED="$EVIDENCE_DIR/$FAMILY"; mkdir -p "$ED/features"
MASKARGS=""; for m in ${MASK_BEDS:-}; do [ -s "$m" ] && MASKARGS="$MASKARGS --mask $m"; done
REFARG=""; [ -n "${REF_FA:-}" ] && [ -s "$REF_FA" ] && REFARG="--reference $REF_FA"
n_done=0
while IFS=$'\t' read -r child father mother; do
  [ -n "$father" ] && [ "$father" != "0" ] && [ -n "$mother" ] && [ "$mother" != "0" ] || { echo "skip duo (P19)"; continue; }
  for cls in snv_indel sv tr; do
    EV="$ED/evidence/$child.$cls.evidence.tsv"; RV="$ED/evidence/$child.$cls.evidence.review.tsv"
    CA="$ED/candidates/$child.$cls.candidates.tsv"
    if [ ! -s "$RV" ]; then [ -s "$EV" ] || { echo "ERROR: neither $RV nor $EV exists" >&2; exit 3; }; mv "$EV" "$RV"; fi
    [ -s "$CA" ] || { echo "ERROR: candidates missing for $cls" >&2; exit 3; }
    t0=$(date +%s)
    "$PHASE_DNM_PYTHON" -m phase_dnm.cli reclassify --evidence "$RV" --out "$EV.tmp" --thresholds "$THR" && mv "$EV.tmp" "$EV"
    "$PHASE_DNM_PYTHON" -m phase_dnm.cli likelihood --evidence "$EV" --out "$ED/evidence/$child.$cls.evidence.lik.tsv" --thresholds "$THR"
    "$PHASE_DNM_PYTHON" -m phase_dnm.cli features --evidence "$EV" --candidates "$CA" --child "$child" --manifest "$MANIFEST" \
        --out "$ED/features/$child.$cls.features.tsv" --rf-out "$ED/features/$child.$cls.features.rf.tsv" $MASKARGS $REFARG \
        --registry "$HERE/config/features.yaml"
    echo "reclassify+likelihood+features $cls done for one child of $FAMILY in $(( $(date +%s) - t0 )) s"
  done
  n_done=$((n_done+1))
done < <(awk -F'\t' -v f="$FAMILY" 'NR>1 && $2==f && $7=="offspring" {print $1"\t"$3"\t"$4}' "$MANIFEST")
[ "$n_done" -gt 0 ] || { echo "ERROR: no child processed for $FAMILY" >&2; exit 3; }
printf 'OK\t%s\t%d children\tthresholds=%s\n' "$(date -Is)" "$n_done" "$(grep -m1 '^version' "$THR" | cut -d'"' -f2)" > "$ED/.recls.status.tmp" && mv "$ED/.recls.status.tmp" "$ED/m2_reclassify.status"

#!/usr/bin/env bash
#SBATCH --job-name=pdnm_lik
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=02:00:00
# P9 likelihood post-step for one family: <child>.<class>.evidence.tsv -> <child>.<class>.evidence.lik.tsv
# Usage: sbatch workflow/m2_likelihood_family.sb <FAMILY_ID>   (or LIST + array)
set -euo pipefail
FAMILY="${1:-}"
if [ -z "$FAMILY" ] && [ -n "${LIST:-}" ] && [ -n "${SLURM_ARRAY_TASK_ID:-}" ]; then FAMILY=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST"); fi
[ -n "$FAMILY" ] || { echo "usage: $0 <FAMILY_ID>  (or LIST + array)" >&2; exit 2; }
HERE="${PHASE_DNM_HOME:-}"
[ -n "$HERE" ] || { [ -n "${SLURM_SUBMIT_DIR:-}" ] && [ -d "${SLURM_SUBMIT_DIR}/src/phase_dnm" ] && HERE="$SLURM_SUBMIT_DIR"; }
[ -n "$HERE" ] || HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -d "$HERE/src/phase_dnm" ] || { echo "ERROR: cannot locate the 13_phase_dnm directory; got '$HERE'" >&2; exit 2; }
source "$HERE/config/phase_dnm.env"
: "${MANIFEST:?}" "${EVIDENCE_DIR:?}" "${PHASE_DNM_PYTHON:?}"
export PYTHONPATH="$HERE/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ED="$EVIDENCE_DIR/$FAMILY/evidence"
n_done=0
while IFS=$'\t' read -r child father mother; do
  [ -n "$father" ] && [ "$father" != "0" ] && [ -n "$mother" ] && [ "$mother" != "0" ] || continue
  for cls in snv_indel sv tr; do
    EV="$ED/$child.$cls.evidence.tsv"; [ -s "$EV" ] || { echo "ERROR: $EV missing" >&2; exit 3; }
    t0=$(date +%s)
    "$PHASE_DNM_PYTHON" -m phase_dnm.cli likelihood --evidence "$EV" --out "$ED/$child.$cls.evidence.lik.tsv" --thresholds "$HERE/config/thresholds.yaml"
    echo "likelihood $cls done for one child of $FAMILY in $(( $(date +%s) - t0 )) s"
  done
  n_done=$((n_done+1))
done < <(awk -F'\t' -v f="$FAMILY" 'NR>1 && $2==f && $7=="offspring" {print $1"\t"$3"\t"$4}' "$MANIFEST")
[ "$n_done" -gt 0 ] || { echo "ERROR: no child processed for $FAMILY" >&2; exit 3; }
printf 'OK\t%s\t%d children\n' "$(date -Is)" "$n_done" > "$EVIDENCE_DIR/$FAMILY/.lik.status.tmp" && mv "$EVIDENCE_DIR/$FAMILY/.lik.status.tmp" "$EVIDENCE_DIR/$FAMILY/m2_likelihood.status"

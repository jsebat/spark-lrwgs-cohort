#!/usr/bin/env bash
#SBATCH --job-name=pdnm_xoreads
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=01:30:00
# M1b2 over the cohort as a job array: one task per family (EXPANSE.md rule 4).
# Usage (from the 13_phase_dnm directory):
#   sbatch --array=1-$(wc -l < "$LIST")%20 --export=ALL,LIST="$LIST" workflow/m1_xoreads_array.sb
# Measured 2026-09-12 (per-gap code): 542-557 s per child, 115 MB; the one-pass code is faster. 1.5 h covers a quad.
set -euo pipefail
: "${LIST:?LIST=/path/to/families.txt must be exported}" "${SLURM_ARRAY_TASK_ID:?run as an array}"
FAMILY=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST")
[ -n "$FAMILY" ] || { echo "ERROR: no family on line $SLURM_ARRAY_TASK_ID of $LIST" >&2; exit 2; }
HERE="${PHASE_DNM_HOME:-${SLURM_SUBMIT_DIR:?}}"
[ -f "$HERE/workflow/m1_xoreads_family.sb" ] || { echo "ERROR: $HERE is not the 13_phase_dnm directory" >&2; exit 2; }
exec bash "$HERE/workflow/m1_xoreads_family.sb" "$FAMILY"

#!/usr/bin/env bash
#SBATCH --job-name=pdnm_cand
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=01:00:00
# M2 candidate generation for one family (DESIGN P5): UNFILTERED candidates of all three classes for every
# complete-trio child, from the family joint VCFs on the filer (GLnexus small variants, sawfish SVs, TRGT).
# Usage: sbatch workflow/m2_candidates_family.sb <FAMILY_ID>   (or LIST + array via SLURM_ARRAY_TASK_ID)
set -euo pipefail
FAMILY="${1:-}"
if [ -z "$FAMILY" ] && [ -n "${LIST:-}" ] && [ -n "${SLURM_ARRAY_TASK_ID:-}" ]; then FAMILY=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST"); fi
[ -n "$FAMILY" ] || { echo "usage: $0 <FAMILY_ID>  (or LIST + array)" >&2; exit 2; }
HERE="${PHASE_DNM_HOME:-}"
[ -n "$HERE" ] || { [ -n "${SLURM_SUBMIT_DIR:-}" ] && [ -d "${SLURM_SUBMIT_DIR}/src/phase_dnm" ] && HERE="$SLURM_SUBMIT_DIR"; }
[ -n "$HERE" ] || HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -d "$HERE/src/phase_dnm" ] || { echo "ERROR: cannot locate the 13_phase_dnm directory; got '$HERE'" >&2; exit 2; }
source "$HERE/config/phase_dnm.env"
: "${MANIFEST:?}" "${CALLSET_ROOT:?}" "${EVIDENCE_DIR:?}" "${PHASE_DNM_PYTHON:?}"
export PYTHONPATH="$HERE/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
OUT="$EVIDENCE_DIR/$FAMILY/candidates"; mkdir -p "$OUT"
O="$CALLSET_ROOT/$FAMILY/out"
SMALL=$(ls "$O"/joint_small_variants_vcf/*.vcf.gz 2>/dev/null | head -1)
SV=$(ls "$O"/joint_sv_vcf/*.vcf.gz 2>/dev/null | head -1)
TR=$(ls "$O"/joint_trgt_vcf/*.vcf.gz 2>/dev/null | head -1)
for f in "$SMALL" "$SV" "$TR"; do [ -s "$f" ] || { echo "ERROR: a family joint VCF is missing under $O" >&2; exit 3; }; done

n_done=0
while IFS=$'\t' read -r child father mother; do
  [ -n "$father" ] && [ "$father" != "0" ] && [ -n "$mother" ] && [ "$mother" != "0" ] || { echo "skip duo (P19)"; continue; }
  for cls in snv_indel sv tr; do
    case $cls in snv_indel) V=$SMALL;; sv) V=$SV;; tr) V=$TR;; esac
    t0=$(date +%s)
    "$PHASE_DNM_PYTHON" -m phase_dnm.cli candidates --child "$child" --manifest "$MANIFEST" --class "$cls" --vcf "$V" \
        --out-dir "$OUT" --thresholds "$HERE/config/thresholds.yaml"
    echo "candidates $cls done for one child of $FAMILY in $(( $(date +%s) - t0 )) s"
  done
  n_done=$((n_done+1))
done < <(awk -F'\t' -v f="$FAMILY" 'NR>1 && $2==f && $7=="offspring" {print $1"\t"$3"\t"$4}' "$MANIFEST")
[ "$n_done" -gt 0 ] || { echo "ERROR: no child processed for $FAMILY" >&2; exit 3; }
printf 'OK\t%s\t%d children\n' "$(date -Is)" "$n_done" > "$OUT/.status.tmp" && mv "$OUT/.status.tmp" "$OUT/m2_candidates.status"

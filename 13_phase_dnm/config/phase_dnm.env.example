# 13_phase_dnm configuration. Copy to config/phase_dnm.env; sourced AFTER config/cohort.env.
# Nothing in here is a sample or person identifier. Family and sample IDs are always arguments.
#
# Layout confirmed 2026-09-12 against the cohort directory on the lab filer: every family has
# an out/ directory written by HiFi-human-WGS-WDL v3.3.1 with per-sample subdirectories
# 0..n; indexes live in the parallel *_index/ directories, NOT beside the files.

# --- cohort inputs (from cohort.env; repeated here for standalone use) ---
LRC=/path/to/longread_cohort                       # holds MANIFEST, callsets/, freeze1/, shortread/
MANIFEST=$LRC/MANIFEST_lrWGS_105.tsv               # sample_id family_id father_id mother_id sex affected role lr_haplotagged_bam lr_family_sv_vcf lr_family_smallvar_vcf lr_family_trgt_vcf
COHORT_BCF=$LRC/freeze1/freeze1.cohort.bcf         # GLnexus v1.4.3; FORMAT GT RNC DP AD GQ PL; INFO AF AQ AC AN
COHORT_SV_VCF=$LRC/freeze1/freeze1.cohort.sv.vcf.gz      # sawfish 2.2.1 joint; FORMAT GT GQ PL AD CN CNQ PS
COHORT_TRGT_VCF=$LRC/freeze1/freeze1.cohort.trgt.vcf.gz  # TRGT 5.0.0 merge; FORMAT GT AL ALLR SD MC MS AP AM PS
PON_DIR=$LRC/freeze1/pon                           # freeze1.pon65.{snv,sv,trgt}.sites.vcf.gz (+ trgt invariance)
REF_FA=/path/to/human_GRCh38_no_alt_analysis_set.fasta

# --- per-family WDL outputs; {FAMILY} and {IDX} (0..n per-sample subdir) are filled by the scripts ---
CALLSET_ROOT=$LRC/callsets                         # $CALLSET_ROOT/{FAMILY}/out/...
HAPLOTAGGED_BAM_GLOB='merged_haplotagged_bam/*/*.GRCh38.haplotagged.bam'          # index: merged_haplotagged_bam_index/*/<same>.bai
PHASED_SMALLVAR_GLOB='phased_small_variant_vcf/*/*.small_variants.phased.vcf.gz'  # per-sample split of the family joint VCF; HiPhase 1.6.0; FORMAT + PS PF
PHASED_SV_GLOB='phased_sv_vcf/*/*.structural_variants.phased.vcf.gz'            # HiPhase DID phase sawfish SVs (PS present)
PHASED_TRGT_GLOB='phased_trgt_vcf/*/*.trgt.sorted.vcf.gz'
JOINT_SMALLVAR_GLOB='joint_small_variants_vcf/*/*.vcf.gz'                        # family joint VCF, all members -> UNFILTERED candidate source
HIPHASE_BLOCKS_GLOB='phase_blocks/*/*.hiphase.blocks.tsv'         # source_block_index sample_name phase_block_id chrom start end num_variants
HIPHASE_HAPLOTAGS_GLOB='phase_haplotags/*/*.hiphase.haplotags.tsv.gz'  # read_name -> haplotag per block (~2.8M rows/sample): THE read->HP sidecar
HIPHASE_STATS_GLOB='phase_stats/*/*.hiphase.stats.tsv'            # per chromosome: num_phased, num_blocks, block_ng50, ...
TRGT_SPANNING_BAM_GLOB='trgt_spanning_reads/*/*.trgt.spanning.sorted.bam'  # per-read AL:i (allele length), MC, HP, PS tags -> TR adapter input
SV_SUPPORTING_READS_GLOB='sv_supporting_reads/*.supporting_reads.json.gz'  # {sawfish_id: {sample: [read_name,...]}} -> SV adapter alt-support hook
GVCF_GLOB='small_variant_gvcf/*/*.small_variants.g.vcf.gz'

# --- module outputs ---
PHASE_DIR=/path/to/analysis_outputs/phase          # M1: orientation, transmission, crossovers, hapdepth, readtags, phase_qc
EVIDENCE_DIR=/path/to/analysis_outputs/phase_dnm   # M2: evidence parquet + reads jsonl per family/class
FINAL_DIR=/path/to/analysis_outputs/phase_dnm/final
TRAIN_DIR=/path/to/analysis_outputs/phase_dnm/train

# --- orthogonal data (validation only, never features) ---
WES_PVCF_GLOB=/path/to/SPARK_iWES_v3/variants/snv/deepvariant/pvcf/*.deepvariant.chr*.vcf.gz   # exonic SNV/indel concordance; 101/105 samples present
WES_PED=/path/to/SPARK_iWES_v3/SPARK_iWES_v3.ped
WES_CRAM_DIR=$LRC/shortread/wes_crams              # GraphTyper re-genotyping of exonic SV candidates only
WES_XHMM_DIR=$LRC/shortread/xhmm
# short-read WGS: essentially absent for this cohort (3 CRAMs); short-read TR calls: none

# --- tools / environment ---
SIF=/path/to/phase_dnm.sif                         # Apptainer image: pysam cyvcf2 polars xgboost scikit-learn samtools bcftools
LAB_COMMANDS=/path/to/longread-autism/cohort/lab_commands.sh   # lab_submit / lab_status wrappers (EXPANSE.md rule 3, 5)
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1    # login-node bcftools/samtools die on BLAS allocation without this

# --- thresholds are NOT here; they are versioned in config/thresholds.yaml ---

# Copy to config/cohort.env and edit. Nothing in here should be a sample or person identifier.
DATA_ROOT=/path/to/analysis_outputs            # where tiering/, sv_validation/, pon/ etc. are written
WORKFLOW_ROOT=/path/to/spark-lrwgs-cohort      # repo checkout; wrappers resolve scripts from here
PROJECT_ROOT=/path/to/projects
COHORT_BCF=$PROJECT_ROOT/freeze1/cohort.bcf
COHORT_SV_VCF=$PROJECT_ROOT/freeze1/cohort.sv.vcf.gz
COHORT_TRGT_VCF=$PROJECT_ROOT/freeze1/cohort.trgt.vcf.gz
RUNROOT=/path/to/per_family_runs          # run_<FAMILY>/analysis/<FAMILY>.ped etc.
SIF_CACHE=/path/to/miniwdl/singularity_cache   # *pb_wdl_base*.sif, slivar, somalier images (01_qc, 03_tiering, 04_panel)
MASK_BED=/path/to/mask.segdup_repeat.bed.gz    # bgzipped exclude BED used by 01_qc/family_downstream.sb
SOMALIER_SITES=/path/to/somalier/sites.hg38.vcf.gz
REF_FA=/path/to/GRCh38_no_alt.fa
VEP_CACHE=/path/to/VEP_CACHE
VEP_PLUGINS=/path/to/VEP_PLUGINS
LOFTEE=/path/to/loftee
DBNSFP_GZ=/path/to/dbNSFP.gz
DBNSFP_PARQUET=/path/to/dbNSFP/parquet_expanded_mane_select
GENEBAYES_TSV=/path/to/GeneBayes/Supplementary_Table_1.tsv
GENCODE_GTF=/path/to/gencode.v44.annotation.gtf.gz
REGIONS_DIR=/path/to/regions              # genomicSuperDups.bed simpleRepeat.bed rmsk.bed
GENE_SETS_DIR=/path/to/gene_sets
EXCLUDE_FAMILY=                           # optional: one family id to exclude from cohort steps
AF_MAX=0.001
SHET_T1=0.18
SHET_T2=0.03
# methylation (12) and transmission (09)
CPG_DIR=/path/to/cpg_links            # <sample>.{combined,hap1,hap2}.bed.gz with .tbi beside each
PHASED_VCF_DIR=/path/to/vcf_links     # <family>.phased.vcf.gz with .tbi beside each
METH_REFS=/path/to/refs/methylation   # geneimprint_human_imprinted.tsv, Atlas.U25.l4.hg38.tsv
GENCODE_GTF=/path/to/gencode.v44.annotation.gtf.gz
COHORT_BCF=/path/to/cohort.bcf
COHORT_SV_VCF=/path/to/cohort.sv.vcf.gz
COHORT_TRGT_VCF=/path/to/cohort.trgt.vcf.gz
SHET_TABLE=/path/to/shet_by_symbol.tsv
GENEBAYES_TABLE=/path/to/GeneBayes_Supplementary_Table_1.tsv
GNOMAD_CONSTRAINT=/path/to/gnomad.v4.1.constraint_metrics.tsv
SHORTREAD_ROOT=/path/to/rare_variant_pipeline_outputs   # nf_rare_<cohort>/output/indexed/<chr>.merged.tsv.gz
PED_SPARK_WGS=/path/to/spark_wgs.ped
PED_SPARK_WES=/path/to/spark_wes.ped
PED_SSC=/path/to/ssc.ped
EXCLUDE_RUNS=                          # optional regex of run directories to skip when linking inputs

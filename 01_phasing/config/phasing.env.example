# 01_phasing configuration. Copy to config/phasing.env (gitignored); sourced AFTER config/cohort.env.
# Nothing in here is a sample or person identifier. Family and sample IDs are always arguments.
#
# The variable NAMES are exactly the ones 13_phase_dnm/config/phase_dnm.env already uses, so on a
# machine where that file exists a symlink reproduces the current setup with no edit and no
# behaviour change:
#
#     ln -s ../../13_phase_dnm/config/phase_dnm.env 01_phasing/config/phasing.env
#
# PHASING_HOME and PHASING_PYTHON are accepted as overrides of PHASE_DNM_HOME / PHASE_DNM_PYTHON by
# every script here; when they are unset the older names are used unchanged.

# --- cohort inputs (from cohort.env; repeated here for standalone use) ---
LRC=/path/to/longread_cohort                       # holds MANIFEST, callsets/, freeze1/
MANIFEST=$LRC/MANIFEST_lrWGS_105.tsv               # sample_id family_id father_id mother_id sex affected role lr_haplotagged_bam lr_family_sv_vcf lr_family_smallvar_vcf lr_family_trgt_vcf
REF_FA=/path/to/human_GRCh38_no_alt_analysis_set.fasta

# --- per-family WDL outputs; {FAMILY} is filled by the scripts ---
CALLSET_ROOT=$LRC/callsets                         # $CALLSET_ROOT/{FAMILY}/out/...
# Indexes live in the parallel *_index/ directories, NOT beside the files (HiFi-human-WGS-WDL v3.3.1).
HAPLOTAGGED_BAM_GLOB='merged_haplotagged_bam/*/*.GRCh38.haplotagged.bam'          # index: merged_haplotagged_bam_index/*/<same>.bai
PHASED_SMALLVAR_GLOB='phased_small_variant_vcf/*/*.small_variants.phased.vcf.gz'  # per-sample split of the family joint VCF; HiPhase 1.6.0; FORMAT + PS PF
HIPHASE_BLOCKS_GLOB='phase_blocks/*/*.hiphase.blocks.tsv'         # source_block_index sample_name phase_block_id chrom start end num_variants
HIPHASE_STATS_GLOB='phase_stats/*/*.hiphase.stats.tsv'            # per chromosome: num_phased, num_blocks, block_ng50, ...

# --- module outputs ---
PHASE_DIR=/path/to/analysis_outputs/phase          # orientation, transmission, change points, hapdepth, phase_qc
                                                   # consumed BY PATH by 13_phase_dnm (its phase_dnm.env names the same directory)

# --- tools / environment ---
PHASE_DNM_PYTHON=/path/to/env/bin/python           # Python >= 3.10 (a lab micromamba env); the login-node python3 is 3.6 and is NEVER used
# PHASING_PYTHON=                                  # optional override, takes precedence over PHASE_DNM_PYTHON
LAB_COMMANDS=/path/to/longread-autism/cohort/lab_commands.sh   # lab_submit / lab_status wrappers (EXPANSE.md rule 3, 5)
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1    # login-node bcftools/samtools die on BLAS allocation without this

# --- thresholds are NOT here; they are versioned in config/thresholds.yaml ---

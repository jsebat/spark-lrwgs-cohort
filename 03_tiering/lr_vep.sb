#!/usr/bin/env bash
#SBATCH --job-name=lr_vep
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=12:00:00
# VEP + LOFTEE annotation of the long-read cohort, one chromosome per array task.
# Purpose: LoF tiering (D64). Only what the tier needs is requested:
#   LOFTEE  -> LoF / LoF_filter        (the LoF call itself)
#   dbNSFP  -> gnomAD 4.1 joint AF     (global AF, per JS 2026-09-05)
#   SYMBOL / Gene                      (join key to GeneBayes s_het)
# SpliceAI and MaxEntScan are deliberately omitted: not used by the LoF tier.
set -uo pipefail

CHROMS=(chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 \
        chr13 chr14 chr15 chr16 chr17 chr18 chr19 chr20 chr21 chr22 chrX chrY)
CHROM=${CHROMS[$((SLURM_ARRAY_TASK_ID-1))]}
[ -n "$CHROM" ] || { echo "FATAL: no chrom for task $SLURM_ARRAY_TASK_ID"; exit 2; }

BCF=/expanse/projects/sebat1/longread_cohort_2026/freeze1/freeze1.cohort.bcf
WORK=/expanse/lustre/projects/ddp195/jsebat/longread-autism/tiering
SITES=$WORK/sites; VEPD=$WORK/vep
mkdir -p "$SITES" "$VEPD"

# the rare-variant pipeline resources moved on 2026-09-16 (G2MH reorganization); override with G2MH_PIPELINE
P="${G2MH_PIPELINE:-/expanse/projects/sebat1/s3/data/sebat/G2MH/legacy/pre-2026-09-reorganization/scripts/scripts_for_rare_pipeline}"
RES=$P/resources
VEP_SIF=$P/ensembl-vep_115.2--pl5321h2a3209d_1.with_samtools
REF=/expanse/projects/sebat1/j3guevar/GRCh38_reference_genome/GRCh38_full_analysis_set_plus_decoy_hla.fa

source /etc/profile.d/modules.sh 2>/dev/null; source /etc/profile.d/lmod.sh 2>/dev/null
module load singularitypro/4.1.2
command -v singularity >/dev/null || { echo "FATAL: singularity not on PATH"; exit 3; }
BT_SIF=$(ls /expanse/projects/sebat1/jsebat/singularity_cache/miniwdl/*pb_wdl_base*.sif | head -1)
sx() { singularity exec -B /expanse:/expanse "$@"; }

echo "=== $CHROM : sites-only extract ==="
S=$SITES/$CHROM.sites.vcf.gz
if [ -s "$S" ] && ! sx "$BT_SIF" bcftools index -n "$S" >/dev/null 2>&1; then
  echo "  existing sites VCF is not a valid indexed file (truncated by a killed task?) -- rebuilding"; rm -f "$S" "$S.tbi"   # T12
fi
if [ ! -s "$S" ]; then
  sx "$BT_SIF" bash -c "bcftools view -G -r '$CHROM' '$BCF' -Oz -o '$S' && bcftools index -t '$S'"
  rc=$?; [ $rc -eq 0 ] || { echo "FATAL: sites extract rc=$rc"; exit $rc; }
fi
N=$(sx "$BT_SIF" bcftools index -n "$S")
echo "  sites: $N"
if [ "$N" -eq 0 ]; then
  echo "  SKIP: zero sites on $CHROM (expected for chrY in some callsets)"
  exit 0
fi

echo "=== $CHROM : VEP + LOFTEE ==="
OUT=$VEPD/$CHROM.vep.vcf.gz
sx "$VEP_SIF" vep \
  --input_file "$S" --format vcf --output_file "$OUT" --vcf --compress_output bgzip \
  --assembly GRCh38 --cache --dir_cache "$P/VEP_CACHE" --offline --fasta "$REF" \
  --minimal --canonical --mane --symbol --biotype --numbers --uploaded_allele \
  --allele_number --pick_allele --force_overwrite --fork "${SLURM_CPUS_PER_TASK:-8}" \
  --no_stats \
  --dir_plugins "$P/VEP_PLUGINS_ALL" \
  --plugin dbNSFP,"$RES/dbNSFP/dbNSFP5.3a_grch38.gz",transcript_match=1,gnomAD4.1_joint_AF,gnomAD4.1_joint_nhomalt,gnomAD4.1_joint_POPMAX_AF \
  --plugin LoF,loftee_path:"$P/VEP_PLUGINS/loftee",human_ancestor_fa:"$RES/LOFTEE/human_ancestor.fa.gz",gerp_bigwig:"$RES/LOFTEE/gerp_conservation_scores.homo_sapiens.GRCh38.bw",conservation_file:"$RES/LOFTEE/loftee.sql"
rc=$?
echo "vep rc=$rc"
[ $rc -eq 0 ] || exit $rc
[ -s "$OUT" ] || { echo "FATAL: empty VEP output"; exit 1; }
sx "$BT_SIF" bcftools index -t "$OUT"
echo "  annotated records: $(sx "$BT_SIF" bcftools index -n "$OUT")"
echo "  HC LoF records:    $(sx "$BT_SIF" bcftools view -H -i 'INFO/CSQ~"HC"' "$OUT" | wc -l)"
echo "=== $CHROM done ==="

# 00_upstream site configuration (copy to config/upstream.env; that file is gitignored). No identifiers here.
WDL_DIR=/path/to/HiFi-human-WGS-WDL              # git checkout at tag v3.3.1 (commit 477ef39)
WDL_ENV=wdl_env                                  # micromamba env with miniwdl + the slurm_singularity plugin
SINGULARITY_MODULE=singularitypro/4.1.2
MICROMAMBA_BIN=/path/to/micromamba                # driver_family.sb; default: the one on PATH, then $HOME/bin/micromamba
RESOURCES_ROOT=/path/to/hifi-wdl-resources-v3.1.0  # PacBio resource bundle; fill the *.template.tsv maps with it
INPUTS_DIR=/path/to/config/inputs                # <FAMILY>.inputs.json per family (make_inputs.py)
RUNROOT=/path/to/scratch/wdl_runs                # miniwdl run directories, one per family (Lustre)
SLURM_ACCOUNT=<account>
SLURM_PARTITION=<partition>
SLURM_QOS=<qos>
NOTIFY_EMAIL=                                    # optional: --mail-user for driver END/FAIL
# cohort-wide joint call (cohort/glnexus_full.sb)
CALLSETS_DIR=/path/to/per-sample/gvcfs
FREEZE_DIR=/path/to/freeze1
SCRATCH_ROOT=/path/to/scratch
SIF_CACHE=/path/to/singularity_cache/miniwdl
# manifest builders
SPARK_METADATA_DIR=/path/to/spark/metadata
REACH_METADATA_TSV=/path/to/reach_manifest.tsv

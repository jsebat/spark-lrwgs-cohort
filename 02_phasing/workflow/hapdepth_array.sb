#!/usr/bin/env bash
#SBATCH --job-name=pdnm_hapdepth
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=01:00:00
# M1 hapdepth over the cohort as a job array: one task per SAMPLE, per-haplotype depth in 1 kb bins (DESIGN P7).
# Usage (from the 02_phasing directory):
#   sbatch --array=1-$(wc -l < "$LIST")%25 --export=ALL,LIST="$LIST" workflow/hapdepth_array.sb
# LIST: one sample id per line, built from the manifest at submission time (data; *.samples.txt is gitignored).
# The BAM path is the manifest's lr_haplotagged_bam column; its index is the same name in the sibling
# merged_haplotagged_bam_index/ directory (the WDL writes indexes there). Measured 2026-09-12 on a 5 Mb region:
# ~4,200 primary reads/s, 56 MB RSS -> ~17 min and well under 1 GB for a ~22x genome.
set -euo pipefail
: "${LIST:?LIST=/path/to/hapdepth.samples.txt must be exported}" "${SLURM_ARRAY_TASK_ID:?run as an array}"
HERE="${PHASING_HOME:-${PHASE_DNM_HOME:-${SLURM_SUBMIT_DIR:?}}}"
[ -f "$HERE/src/trio_phase/phasing/hapdepth.py" ] || { echo "ERROR: $HERE is not the 02_phasing directory" >&2; exit 2; }
source "$HERE/config/phasing.env"
: "${MANIFEST:?}" "${PHASE_DIR:?}"
PY="${PHASING_PYTHON:-${PHASE_DNM_PYTHON:-}}"; : "${PY:?set PHASING_PYTHON (or PHASE_DNM_PYTHON) to a Python >= 3.10}"
export PYTHONPATH="$HERE/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
SAMPLE=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST")
[ -n "$SAMPLE" ] || { echo "ERROR: no sample on line $SLURM_ARRAY_TASK_ID of $LIST" >&2; exit 2; }
# The manifest's lr_haplotagged_bam column points at the ORIGINAL run directories on Lustre (first attempt failed
# 105/105 on it). Resolve from the persistent callset tree on the filer instead; the manifest supplies the family.
FAMILY=$(awk -F'\t' -v s="$SAMPLE" 'NR>1 && $1==s {print $2}' "$MANIFEST")
[ -n "$FAMILY" ] || { echo "ERROR: sample not in the manifest" >&2; exit 3; }
: "${CALLSET_ROOT:?}"
BAM=$(ls "$CALLSET_ROOT/$FAMILY"/out/merged_haplotagged_bam/*/"$SAMPLE".*.haplotagged.bam 2>/dev/null | head -1 || true)   # || true: under -e -o pipefail a no-match ls exited before the fallback (P5)
if [ ! -s "$BAM" ]; then
  BAM=$(awk -F'\t' -v s="$SAMPLE" 'NR>1 && $1==s {print $8}' "$MANIFEST")     # fallback: manifest path
fi
[ -s "$BAM" ] || { echo "ERROR: haplotagged BAM not found for this sample under $CALLSET_ROOT/$FAMILY (nor at the manifest path)" >&2; exit 3; }
BAI="${BAM/merged_haplotagged_bam\//merged_haplotagged_bam_index/}.bai"
[ -s "$BAI" ] || BAI="$BAM.bai"
[ -s "$BAI" ] || { echo "ERROR: BAM index not found (tried sibling *_index dir and .bai beside the BAM)" >&2; exit 3; }
OUT="$PHASE_DIR/hapdepth"; mkdir -p "$OUT"
t0=$(date +%s)
"$PY" -m trio_phase.cli hapdepth --bam "$BAM" --bai "$BAI" \
    --out "$OUT/$SAMPLE.hapdepth.tsv.gz" --summary "$OUT/$SAMPLE.hapdepth.summary.json" \
    --bin-size "$("$PY" -c 'import yaml,sys; print(yaml.safe_load(open(sys.argv[1]))["hapdepth"]["bin_size"])' "$HERE/config/thresholds.yaml")" \
    --min-mapq  "$("$PY" -c 'import yaml,sys; print(yaml.safe_load(open(sys.argv[1]))["hapdepth"]["min_mapq"])' "$HERE/config/thresholds.yaml")"   # from thresholds.yaml, whose hapdepth: section nobody read
echo "hapdepth done for one sample in $(( $(date +%s) - t0 )) s"
printf 'OK\t%s\n' "$(date -Is)" > "$OUT/.$SAMPLE.status.tmp" && mv "$OUT/.$SAMPLE.status.tmp" "$OUT/$SAMPLE.hapdepth.status"

#!/usr/bin/env bash
#SBATCH --job-name=clogit
#SBATCH --account=ddp195
#SBATCH --partition=ind-shared
#SBATCH --qos=ind-shared-normal
#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=2 --mem=8G --time=00:30:00
set -uo pipefail
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
eval "$(micromamba shell hook --shell bash)"
micromamba activate rclogit
Rscript "${WORKFLOW_ROOT:?set WORKFLOW_ROOT to the repo checkout}"/08_burden/clogit.R
